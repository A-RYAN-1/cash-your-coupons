# Firebase web app settings, from Firebase Console > Project settings > Your apps > SDK setup.
# They identify your project to the client SDK and are not secrets: access is controlled by
# Firestore security rules and Authentication, not by hiding these. Every one is required.
# Expo inlines EXPO_PUBLIC_* values into the app at build time.
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
