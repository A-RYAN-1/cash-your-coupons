# Address of the Cash Your Coupons API (the server/ folder), without a trailing slash.
# Local: the API started with `npm start` in server/. Hosted: the Render service URL.
# It is public (the app calls it from the browser), so it holds no secret.
# Expo inlines EXPO_PUBLIC_* values into the app at build time.
EXPO_PUBLIC_API_URL=http://localhost:5000
