# Postgres connection string. Local: the compose.yaml database. Hosted: the Neon connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/coupons
# Signs login tokens: any random string of at least 32 characters (openssl rand -hex 32).
JWT_SECRET=replace-with-a-long-random-string-of-32-chars-or-more
# How long a login lasts.
JWT_EXPIRES_IN=7d
# Port the API listens on. Render sets PORT itself.
PORT=5000
# Comma-separated browser origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:8081
# true when the database needs TLS from outside its network (Neon).
DATABASE_SSL=false
# Password recovery mail through Brevo (free, 300 a day). Leave empty to send nothing.
BREVO_API_KEY=
# A sender address verified in Brevo.
MAIL_FROM=
